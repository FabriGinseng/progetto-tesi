# Required: Google API key used by @langchain/google-genai's
# GoogleGenerativeAIEmbeddings. Get one at aistudio.google.com/apikey.
GOOGLE_API_KEY=your-gemini-key-here

# Optional overrides — sensible defaults are baked into src/rag/ingestion.ts
# and src/rag/retrieval.ts.
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_CHAT_MODEL=gemini-3.5-flash
# MOCK_FSE_BASE_URL=http://localhost:3000
# CHROMA_COLLECTION=fse_documents
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=5

# --- Local/self-hosted Chroma (used only if CHROMA_API_KEY is unset below) ---
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# --- Chroma Cloud (takes over from local Chroma the moment this is set) ---
# Get these from your Chroma Cloud dashboard (trychroma.com): API Keys page
# for CHROMA_API_KEY, and your database's settings for tenant/database.
# CHROMA_API_KEY=ck-your-key-here
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=your-database-name
